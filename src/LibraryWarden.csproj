<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LibraryWarden</RootNamespace>
    <AssemblyName>LibraryWarden</AssemblyName>
    <Product>LibraryWarden</Product>
    <AssemblyTitle>LibraryWarden</AssemblyTitle>
    <Description>Lädt die eigene GOG-Bibliothek herunter und meldet neue Inhalte.</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Fluent-Design (ThemeMode) ist in .NET als "experimentell" markiert.
         WFO0003: WinForms-Hinweis zur DPI-Einstellung; hier ist WPF die App (WinForms nur fürs Tray-Symbol),
                  daher gehört PerMonitorV2 ins Manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
