<Window x:Class="LibraryWarden.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LibraryWarden.UI"
        Title="LibraryWarden" Width="1280" Height="820" MinWidth="900" MinHeight="580"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource Lw.WindowBg}" Foreground="{DynamicResource Lw.Text}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource Lw.WindowBg}">
        <Grid x:Name="RootGrid">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Titelleiste ===== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Lw.Chrome}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TitleLeft" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="TitleIcon" Source="/Assets/app.ico" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Text="LibraryWarden" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="AccountText" FontSize="12" Foreground="{DynamicResource Lw.TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource CaptionButton}" FontSize="14" Content="&#xE708;"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="ThemeToggle_Click" ToolTip="Dunkles Design"/>
                    <Border Width="1" Margin="2,9" Background="{DynamicResource Lw.Line}"/>
                </StackPanel>
                <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimieren"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Schließen"/>
                </StackPanel>
            </Grid>

            <!-- ===== Menüband: Registerkarten ===== -->
            <DockPanel Grid.Row="1" Background="{DynamicResource Lw.Chrome}" Margin="6,0,8,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="TabLibrary" Style="{StaticResource RibbonTab}" Tag="library" Content="Bibliothek" IsChecked="True"
                                 Checked="RibbonTab_Checked" MouseDoubleClick="RibbonTab_DoubleClick"/>
                    <RadioButton x:Name="TabChanges" Style="{StaticResource RibbonTab}" Tag="changes"
                                 Checked="RibbonTab_Checked" MouseDoubleClick="RibbonTab_DoubleClick">
                        <TextBlock x:Name="ChangesHeader" Text="Änderungen"/>
                    </RadioButton>
                    <RadioButton x:Name="TabDownloads" Style="{StaticResource RibbonTab}" Tag="downloads"
                                 Checked="RibbonTab_Checked" MouseDoubleClick="RibbonTab_DoubleClick">
                        <TextBlock x:Name="DownloadsHeader" Text="Downloads"/>
                    </RadioButton>
                    <RadioButton x:Name="TabSettings" Style="{StaticResource RibbonTab}" Tag="settings" Content="Einstellungen"
                                 Checked="RibbonTab_Checked" MouseDoubleClick="RibbonTab_DoubleClick"/>
                    <RadioButton x:Name="TabView" Style="{StaticResource RibbonTab}" Tag="view" Content="Ansicht"
                                 Checked="RibbonTab_Checked" MouseDoubleClick="RibbonTab_DoubleClick"/>
                </StackPanel>
                <Button x:Name="RibbonToggleButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70E;"
                        VerticalAlignment="Center" Click="RibbonToggle_Click" ToolTip="Menüband ausblenden (Strg+F1)"/>
            </DockPanel>

            <!-- ===== Menüband: Befehle ===== -->
            <Border x:Name="RibbonPanel" Grid.Row="2" Background="{DynamicResource Lw.Surface}" BorderBrush="{DynamicResource Lw.Line}"
                    BorderThickness="1" CornerRadius="8" Margin="8,0,8,8" Height="100" Padding="4,0">
                <Grid>
                    <!-- Bibliothek -->
                    <StackPanel x:Name="RibbonLibrary" Orientation="Horizontal">
                        <HeaderedContentControl Header="Prüfen" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckButton" Style="{StaticResource RibbonLarge}" Tag="&#xE72C;" Content="Jetzt prüfen" Click="Check_Click"
                                        ToolTip="Bibliotheksliste abrufen und neue oder markierte Spiele prüfen (F5)"/>
                                <Button x:Name="FullCheckButton" Style="{StaticResource RibbonLarge}" Tag="&#xE895;" Content="Vollprüfung" Click="FullCheck_Click"
                                        ToolTip="Alle Spiele komplett mit dem letzten Stand vergleichen (Umschalt+F5)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Herunterladen" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DownloadAllButton" Style="{StaticResource RibbonLarge}" Tag="&#xE896;" Content="Alles Fehlende" Click="DownloadAll_Click"
                                        ToolTip="Alle fehlenden und aktualisierten Inhalte der Bibliothek laden"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE118;" Content="Markierte Spiele" Click="DownloadSelectedGames_Click"
                                        ToolTip="Fehlende Inhalte der markierten Spiele laden"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Spiel" Style="{StaticResource RibbonGroup}">
                            <StackPanel Width="168" Margin="0,3,0,0">
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8B7;" Content="Ordner öffnen" Click="DetailOpenFolder_Click"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE774;" Content="Auf gog.com öffnen" Click="DetailOpenGog_Click"
                                        ToolTip="Öffnet die Shopseite. Ist das Spiel im Shop deines Landes nicht gelistet, die Produktseite bei gogdb.org."/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE73E;" Content="Als gelesen markieren" Click="MarkSelectedGamesRead_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource RibbonGroup}">
                            <HeaderedContentControl.Header>
                                <TextBlock x:Name="FilterCountText" Text="Suchen &amp; Filtern" FontSize="11" Foreground="{DynamicResource Lw.TextMuted}"/>
                            </HeaderedContentControl.Header>
                            <StackPanel Width="240" Margin="0,4,0,0">
                                <Grid>
                                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Height="30" MinHeight="0" Padding="30,0,6,0"
                                             VerticalContentAlignment="Center" ToolTip="Strg+F"/>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Lw.IconFont}" FontSize="13" Foreground="{DynamicResource Lw.TextMuted}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="SearchPlaceholder" Text="Titel suchen …" Foreground="{DynamicResource Lw.TextMuted}"
                                               VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <ComboBox x:Name="FilterBox" Margin="0,6,0,0" Height="30" MinHeight="0" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                          DisplayMemberPath="Display" SelectedValuePath="Value" SelectionChanged="Filter_Changed"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Konto" Style="{StaticResource RibbonGroup}">
                            <Button x:Name="LoginButton" Style="{StaticResource RibbonLarge}" Tag="&#xE77B;" Content="Anmelden" Click="Login_Click"/>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- Änderungen -->
                    <StackPanel x:Name="RibbonChanges" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Herunterladen" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonLarge}" Tag="&#xE896;" Content="Inhalte laden" Click="ChangesDownload_Click"
                                    ToolTip="Fehlende Inhalte der markierten Spiele laden"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Protokoll" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE73E;" Content="Alle gelesen" Click="ChangesMarkRead_Click"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE72A;" Content="Zum Spiel" Click="JumpToGame_Click"
                                        ToolTip="Markiertes Spiel in der Bibliothek zeigen (oder Doppelklick)"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Prüfen" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckButton2" Style="{StaticResource RibbonLarge}" Tag="&#xE72C;" Content="Jetzt prüfen" Click="Check_Click"/>
                                <Button x:Name="FullCheckButton2" Style="{StaticResource RibbonLarge}" Tag="&#xE895;" Content="Vollprüfung" Click="FullCheck_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- Downloads -->
                    <StackPanel x:Name="RibbonDownloads" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Warteschlange" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PauseButton" Style="{StaticResource RibbonLarge}" Tag="&#xE769;" Content="Pausieren" Click="Pause_Click"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE711;" Content="Abbrechen" Click="CancelJobs_Click"
                                        ToolTip="Markierte Downloads abbrechen"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE72C;" Content="Wiederholen" Click="RetryJobs_Click"
                                        ToolTip="Markierte (oder alle) fehlgeschlagenen Downloads erneut versuchen"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE74D;" Content="Erledigte entfernen" Click="ClearJobs_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Übersicht" Style="{StaticResource RibbonGroup}">
                            <TextBlock x:Name="DownloadSummary" Width="360" TextWrapping="Wrap" Margin="4,4,4,0" FontSize="12" LineHeight="17"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Ordner" Style="{StaticResource RibbonGroup}">
                            <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B7;" Content="Bibliothek öffnen" Click="OpenLibraryRoot_Click"/>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- Einstellungen -->
                    <StackPanel x:Name="RibbonSettings" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Einstellungen" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE74E;" Content="Speichern" Click="SaveSettings_Click"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A7;" Content="Verwerfen" Click="ResetSettings_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Ordner" Style="{StaticResource RibbonGroup}">
                            <StackPanel Width="160" Margin="0,3,0,0">
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8F1;" Content="Bibliothek" Click="OpenLibraryRoot_Click"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8B7;" Content="Datenordner" Click="OpenDataDir_Click"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8A5;" Content="Log öffnen" Click="OpenLogDir_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <!-- Ansicht -->
                    <StackPanel x:Name="RibbonView" Orientation="Horizontal" Visibility="Collapsed">
                        <HeaderedContentControl Header="Design" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource RibbonLarge}" GroupName="Theme" Tag="&#xE706;" Content="Hell" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource RibbonLarge}" GroupName="Theme" Tag="&#xE708;" Content="Dunkel" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource RibbonLarge}" GroupName="Theme" Tag="&#xE7F4;" Content="Wie Windows" Checked="Theme_Checked"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Skalierung" Style="{StaticResource RibbonGroup}">
                            <StackPanel Width="236" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Width="30" Height="30" Click="ZoomOut_Click" ToolTip="Verkleinern (Strg+Minus)"/>
                                    <ComboBox x:Name="ScaleBox" Width="168" Height="30" MinHeight="0" Margin="4,0" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Display" SelectedValuePath="Value" SelectionChanged="ScaleBox_SelectionChanged"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Width="30" Height="30" Click="ZoomIn_Click" ToolTip="Vergrößern (Strg+Plus)"/>
                                </StackPanel>
                                <TextBlock x:Name="ScaleInfo" FontSize="11" Foreground="{DynamicResource Lw.TextMuted}" Margin="2,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Fenster" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="TopmostToggle" Style="{StaticResource RibbonLarge}" Tag="&#xE718;" Content="Immer im Vordergrund" Click="Topmost_Click"/>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE70E;" Content="Menüband ausblenden" Click="RibbonToggle_Click"
                                        ToolTip="Strg+F1 oder Doppelklick auf eine Registerkarte"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Inhalt ===== -->
            <TabControl x:Name="Tabs" Grid.Row="3" Style="{StaticResource HeaderlessTabs}" Margin="8,0,8,0" SelectionChanged="Tabs_SelectionChanged">

                <!-- Bibliothek -->
                <TabItem x:Name="LibraryTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="GamesGrid" IsReadOnly="False" RowHeight="36" SelectionChanged="GamesGrid_SelectionChanged">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Fehlendes laden" Click="DownloadSelectedGames_Click"/>
                                    <MenuItem Header="Ordner öffnen" Click="DetailOpenFolder_Click"/>
                                    <MenuItem Header="Auf gog.com öffnen" Click="DetailOpenGog_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Änderungen als gelesen markieren" Click="MarkSelectedGamesRead_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30" CanUserResize="False" SortMemberPath="Unread">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Lw.AccentFg}" ToolTip="Neue Inhalte"
                                                     Visibility="{Binding HasNew, Converter={StaticResource BoolToVis}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Titel" Width="*" SortMemberPath="Title" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNew}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Stand" Width="200" SortMemberPath="StateOrder" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Lw.Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Complete">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.Ok}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Outdated">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.Warn}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Partial">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.Warn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.Info}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Ignored">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.TextMuted}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Nothing">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.TextMuted}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Unknown">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.Bad}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Removed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.TextMuted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Auswahl" Binding="{Binding WantedText}" SortMemberPath="WantedBytes" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Fehlt" Binding="{Binding MissingText}" SortMemberPath="MissingBytes" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Letzte Änderung" Binding="{Binding LastChangeText}" SortMemberPath="LastChange" Width="130" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Bei neuen Inhalten" Width="180" SortMemberPath="Rule">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static ui:Choices.Rules}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Rule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="28" MinHeight="0" Padding="10,0,0,0" FontSize="12" VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DetailDownloadButton" Content="Fehlendes laden" Style="{StaticResource PrimaryButton}" Click="DetailDownload_Click"/>
                                        <Button Content="Ordner öffnen" Click="DetailOpenFolder_Click"/>
                                        <Button Content="Auf gog.com" Click="DetailOpenGog_Click"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" Text="Kein Spiel ausgewählt" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailInfo" Style="{StaticResource Hint}" Margin="0"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="ItemsGrid" IsReadOnly="True" RowHeight="28">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="✓" Binding="{Binding WantedMark}" Width="32"/>
                                        <DataGridTextColumn Header="Art" Binding="{Binding KindText}" Width="135"/>
                                        <DataGridTextColumn Header="Inhalt" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="DLC" Binding="{Binding Product}" Width="*"/>
                                        <DataGridTextColumn Header="System" Binding="{Binding OsText}" Width="80"/>
                                        <DataGridTextColumn Header="Sprache" Binding="{Binding LanguageText}" Width="95"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="130"/>
                                        <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80"/>
                                        <DataGridTemplateColumn Header="Lokal" Width="110" SortMemberPath="StateText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StateText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Lw.TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Complete">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Lw.Ok}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Missing">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Lw.Text}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Outdated">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Lw.Warn}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Partial">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Lw.Warn}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Lw.Info}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Änderungen -->
                <TabItem x:Name="ChangesTab">
                    <DataGrid x:Name="EventsGrid" IsReadOnly="True" Margin="0,0,0,8" MouseDoubleClick="EventsGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Unread}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" SortMemberPath="Time" Width="130"/>
                            <DataGridTextColumn Header="Spiel" Binding="{Binding GameTitle}" Width="270"/>
                            <DataGridTextColumn Header="Art" Binding="{Binding KindText}" Width="115"/>
                            <DataGridTextColumn Header="Beschreibung" Binding="{Binding Text}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Downloads -->
                <TabItem x:Name="DownloadsTab">
                    <DataGrid x:Name="JobsGrid" IsReadOnly="True" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Spiel" Binding="{Binding GameTitle}" Width="200"/>
                            <DataGridTextColumn Header="Inhalt" Binding="{Binding ItemText}" Width="210"/>
                            <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTemplateColumn Header="Fortschritt" Width="230" SortMemberPath="Percent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Height="18">
                                            <ProgressBar Style="{StaticResource BarProgress}" Value="{Binding Percent, Mode=OneWay}" Maximum="100"/>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tempo" Binding="{Binding SpeedText}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Einstellungen -->
                <TabItem x:Name="SettingsTab">
                    <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,16,12">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Speicherort der Bibliothek"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Durchsuchen …" Click="BrowseRoot_Click"/>
                                        <TextBox Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Pro Spiel entsteht ein Ordner mit Unterordnern für System, Patches, Sprachpakete, Extras und DLCs. Ersetzte Versionen landen – je nach Einstellung unten – im Ordner _Archiv."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource CardTitle}" Text="Was soll heruntergeladen werden?"/>

                                    <TextBlock Grid.Row="1" Text="Betriebssysteme" Style="{StaticResource Label}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                        <CheckBox Content="Windows" IsChecked="{Binding Windows}" Margin="0,0,18,0"/>
                                        <CheckBox Content="macOS" IsChecked="{Binding Mac}" Margin="0,0,18,0"/>
                                        <CheckBox Content="Linux" IsChecked="{Binding Linux}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="Sprachen" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,14,10,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                        <TextBox Text="{Binding Languages, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,4"
                                                   Text="Sprachkürzel in Wunschreihenfolge, z. B. „de, en“. Pro Spiel wird die erste verfügbare Sprache geladen (sonst Englisch)."/>
                                        <CheckBox Content="Stattdessen alle aufgeführten Sprachen laden, die es gibt" IsChecked="{Binding AllSelectedLanguages}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding AvailableLanguages}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Text="Inhalte" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,14,10,0"/>
                                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                                        <CheckBox Content="Installer" IsChecked="{Binding IncludeInstallers}" Margin="0,0,18,0"/>
                                        <CheckBox Content="Sprachpakete" IsChecked="{Binding IncludeLanguagePacks}" Margin="0,0,18,0"/>
                                        <CheckBox Content="Extras (Soundtracks, Handbücher, Artbooks …)" IsChecked="{Binding IncludeExtras}" Margin="0,0,18,0"/>
                                        <CheckBox Content="DLCs" IsChecked="{Binding IncludeDlc}"/>
                                    </WrapPanel>

                                    <TextBlock Grid.Row="4" Text="Patches" Style="{StaticResource Label}" Margin="0,10,10,0"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="0,10,0,0"
                                              ItemsSource="{x:Static ui:Choices.PatchModes}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding Patches}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource CardTitle}" Text="Downloads"/>
                                    <TextBlock Grid.Row="1" Text="Gleichzeitig" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,2"
                                              ItemsSource="{x:Static ui:Choices.Parallel}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding ParallelDownloads}"/>
                                    <TextBlock Grid.Row="2" Text="Bandbreite (MB/s)" Style="{StaticResource Label}"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Text="{Binding BandwidthText, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="0 = unbegrenzt" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Text="Alte Versionen" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Width="320" HorizontalAlignment="Left" Margin="0,8,0,0"
                                              ItemsSource="{x:Static ui:Choices.OldVersionModes}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding OldVersions}"/>
                                    <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Content="Dateien nach dem Laden per MD5-Prüfsumme kontrollieren"
                                              IsChecked="{Binding VerifyChecksums}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource CardTitle}" Text="Zwischenspeicher (für externe Festplatten)"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding StagingEnabled}"
                                              Content="Erst in einen schnellen Zwischenspeicher laden, dann am Stück auf die Bibliothek übertragen"/>
                                    <TextBlock Grid.Row="2" Text="Ordner" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,14,10,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Durchsuchen …" Click="BrowseStaging_Click"/>
                                            <TextBox Text="{Binding StagingDir, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding StagingDefaultHint}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Text="Größe (GB)" Style="{StaticResource Label}" Margin="0,8,10,0"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Text="{Binding StagingSizeText, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding StagingSpaceHint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Für Bibliotheken auf einer externen USB-Festplatte: Downloads landen zuerst im Zwischenspeicher (am besten auf der internen SSD) und werden dort geprüft. Ein Kopierer im Hintergrund schreibt sie dann nacheinander und am Stück auf die Festplatte – das schont deren schwache Schreibleistung. Ist der Zwischenspeicher voll, warten neue Downloads; Dateien, die größer sind als der ganze Zwischenspeicher, gehen direkt aufs Ziel. Größe: mindestens gleichzeitige Downloads × größte Datei (Installer-Teile sind bis 4 GB groß) plus Puffer – 20 GB reichen meist. Ist die Festplatte nicht angeschlossen, bleiben die Dateien im Zwischenspeicher und werden später übertragen."/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Style="{StaticResource CardTitle}" Text="Wächter"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Bibliothek automatisch auf neue Inhalte prüfen" IsChecked="{Binding WatcherEnabled}"/>
                                    <TextBlock Grid.Row="2" Text="Schnellprüfung" Style="{StaticResource Label}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0"
                                              ItemsSource="{x:Static ui:Choices.QuickHours}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding QuickCheckHours}"/>
                                    <TextBlock Grid.Row="3" Text="Vollprüfung" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,14,10,0"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                                        <ComboBox Width="220" HorizontalAlignment="Left"
                                                  ItemsSource="{x:Static ui:Choices.FullHours}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding FullCheckHours}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Die Schnellprüfung liest die Bibliotheksliste mit GOGs „Neu/Update“-Markierungen und prüft nur betroffene Spiele. Die Vollprüfung vergleicht alle Spiele Eintrag für Eintrag mit dem letzten Stand."/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Text="Bei neuen Inhalten" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,14,10,0"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                                        <ComboBox Width="320" HorizontalAlignment="Left"
                                                  ItemsSource="{x:Static ui:Choices.DefaultActions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding OnNewContent}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Gilt für alle Spiele mit der Regel „Standard“. Pro Spiel änderbar in der Bibliothek (Spalte „Bei neuen Inhalten“)."/>
                                    </StackPanel>
                                    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" IsChecked="{Binding NotifyGogFlagOnly}"
                                              Content="Auch melden, wenn GOG ein Update markiert, die Offline-Dateien aber gleich bleiben"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Allgemein"/>
                                    <CheckBox Content="Mit Windows starten (unsichtbar im Infobereich)" IsChecked="{Binding Autostart}"/>
                                    <CheckBox Content="Fenster schließen = in den Infobereich minimieren" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Design (Hell/Dunkel), Skalierung und Fensteroptionen findest du im Menüband unter „Ansicht“. Sie werden sofort übernommen."/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Speichern" Style="{StaticResource PrimaryButton}" Margin="0" Padding="24,8" Click="SaveSettings_Click"/>
                                <Button Content="Verwerfen" Padding="18,8" Click="ResetSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ===== Statuszeile ===== -->
            <Border Grid.Row="4" Background="{DynamicResource Lw.Chrome}" BorderBrush="{DynamicResource Lw.Line}" BorderThickness="0,1,0,0" Padding="14,5">
                <DockPanel>
                    <TextBlock x:Name="NextCheckText" DockPanel.Dock="Right" Foreground="{DynamicResource Lw.TextMuted}" FontSize="12" Margin="14,0,0,0"/>
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{DynamicResource Lw.TextMuted}" FontSize="12" Margin="14,0,0,0"/>
                    <ProgressBar x:Name="BusyBar" DockPanel.Dock="Left" Width="70" Height="4" MinHeight="0" IsIndeterminate="True" Visibility="Collapsed"
                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
