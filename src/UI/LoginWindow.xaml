<Window x:Class="LibraryWarden.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Bei GOG anmelden" Width="560" Height="760" MinWidth="420" MinHeight="520"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource Lw.Surface}" Foreground="{DynamicResource Lw.Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Lw.AccentSoft}" BorderBrush="{DynamicResource Lw.Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="HeaderScale" ScaleX="1" ScaleY="1"/>
            </Border.LayoutTransform>
            <TextBlock TextWrapping="Wrap">
                Melde dich mit deinem GOG-Konto an – demselben wie in GOG Galaxy.
                Die Eingaben gehen direkt an GOG; LibraryWarden speichert nur einen verschlüsselten Anmelde-Token.
            </TextBlock>
        </Border>
        <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Lade Anmeldeseite …" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Lw.TextMuted}"/>
        <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
    </Grid>
</Window>
